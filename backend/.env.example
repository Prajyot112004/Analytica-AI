# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/analytica_db

# Security & JWT
SECRET_KEY=analytica_secret_key_change_in_production_2026_super_secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Hugging Face API Configuration (Serverless API Inference - No Local LLM/Embedding Models)
HUGGINGFACEHUB_API_TOKEN=your_huggingface_api_token_here
HF_LLM_MODEL_ID=Qwen/Qwen2.5-Coder-32B-Instruct
HF_EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2

# LangSmith Tracing (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=analytica-ai-v2

# File Uploads & Output Directories
UPLOAD_DIR=uploads
GENERATED_DIR=generated
ALLOWED_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000","*"]
